{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    },
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ]
}