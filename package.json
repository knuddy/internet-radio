{
  "name": "internet-radio",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch --tsconfig backend/tsconfig.json backend/src/server.ts",
    "dev:worker": "tsx watch --tsconfig backend/tsconfig.json backend/src/worker.ts",
    "manage": "tsx --tsconfig backend/tsconfig.json backend/src/manage.ts",
    "build:all": "npm run build --workspaces"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/node": "^24.12.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "tsx": "^4.22.1"
  }
}
